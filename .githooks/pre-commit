#!/usr/bin/env bash
set -eu
inputs=(apps tests .ruff.toml pytest.ini requirements-dev.lock .codex .githooks .github/workflows/quality.yml)
if git diff --cached --quiet -- "${inputs[@]}"; then
    exit 0
fi
if ! git diff --quiet -- "${inputs[@]}"; then
    printf 'Stage or set aside unstaged check inputs before committing.\n' >&2
    exit 1
fi
exec bash .codex/python.sh check
